default_engine = "claude"
transport = "telegram"
default_project = "notes"
watch_config = true

[transports.telegram]
bot_token = "YOUR_BOT_TOKEN"
chat_id = YOUR_CHAT_ID
session_mode = "chat"
show_resume_line = false
allowed_user_ids = [YOUR_USER_ID]

[transports.telegram.topics]
enabled = true
scope = "all"

